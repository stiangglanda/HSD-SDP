- BlankGraphicsObjectFactory()</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLNote</id><coordinates><x>1000</x><y>150</y><w>400</w><h>190</h></coordinates><panel_attributes>Hinweise:
- GraphicsManagement und die beiden Fabriken:
  Meyers-Singleton (static-Variable in GetInstance(),
  automatische Freigabe beim Programmende)
- Alle Klassen ausser dem Interface erben von Object
  (Kopieren und Zuweisen verhindert)
- Ein Image bekommt genau eine Fabrik =&gt; nur gefuellte
  oder nur nicht gefuellte Objekte</panel_attributes><additional_attributes></additional_attributes></element><element><id>Relation</id><coordinates><x>220</x><y>65</y><w>390</w><h>135</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>380;10;10;10;10;125</additional_attributes></element><element><id>Relation</id><coordinates><x>0</x><y>40</y><w>610</w><h>470</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>600;10;10;10;10;460;30;460</additional_attributes></element><element><id>Relation</id><coordinates><x>690</x><y>96</y><w>20</w><h>324</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>10;10;10;314</additional_attributes></element><element><id>Relation</id><coordinates><x>570</x><y>50</y><w>920</w><h>1210</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>230;10;910;10;910;1200;10;1200;10;1130</additional_attributes></element><element><id>Relation</id><coordinates><x>790</x><y>75</y><w>670</w><h>1045</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>10;10;660;10;660;1035;550;1035</additional_attributes></element><element><id>Relation</id><coordinates><x>220</x><y>340</y><w>20</w><h>90</h></coordinates><panel_attributes>lt=&lt;&lt;&lt;&lt;-
